@model HanyOptics.BusinessLogic.Models.EditOrderCustomerRequest
@using HanyOptics.Domain.Entities
@{
    ViewData["Title"] = "طلب جديد";
    var order = (Order)ViewBag.Order;
}

<div class="page-header">
    <span class="page-header-title disabled" title="أكمل الطلب الحالي أو ألغه أولاً لبدء طلب جديد">➕ طلب جديد</span>
    <form asp-action="Cancel" method="post" onsubmit="return confirm('سيتم إلغاء هذا الطلب نهائياً. هل أنت متأكد؟');">
        <input type="hidden" name="orderId" value="@order.OrderId" />
        <button type="submit" class="btn btn-outline">إلغاء</button>
    </form>
</div>

<div class="wizard-steps">
    <div class="wizard-step active">
        <div class="step-num">١</div>
        <div class="step-label">العميل</div>
    </div>
    <div class="wizard-step">
        <div class="step-num">٢</div>
        <div class="step-label">البيانات والروشتة</div>
    </div>
    <div class="wizard-step">
        <div class="step-num">٣</div>
        <div class="step-label">الدفع والتأكيد</div>
    </div>
</div>

<div class="wizard-content">
    <div class="alert alert-info">📌 هذا الطلب تم إنشاؤه بالفعل — يمكن تعديل رقم الهاتف (لو كتبته غلط) ونوع التسليم فقط. رقم الفاتورة لا يمكن تغييره.</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="EditOrder" method="post" id="editForm">
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="DoctorId" />

        <div class="form-group">
            <label>📄 رقم الفاتورة</label>
            <input value="@order.InvoiceNumber" disabled />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Phone">📱 رقم الهاتف *</label>
                <input type="tel" asp-for="Phone" id="phoneInput" placeholder="01XXXXXXXXX" maxlength="11" autocomplete="off" required />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerName">👤 اسم الزبون</label>
                <input asp-for="CustomerName" id="customerNameInput" placeholder="اسم الزبون (اختياري)" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="DeliveryType">🚚 نوع التسليم</label>
            <select asp-for="DeliveryType">
                <option value="Normal">عادي (العدسات تحتاج وقت)</option>
                <option value="Immediate">فوري (شمسية / إطار فقط)</option>
            </select>
        </div>

        <div class="wizard-footer">
            <a class="btn btn-outline" asp-action="NewItem" asp-route-orderId="@order.OrderId" asp-route-doctorId="@Model.DoctorId">→ رجوع بدون حفظ</a>
            <button type="submit" class="btn btn-primary btn-lg">حفظ ومتابعة ←</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const phoneInput = document.getElementById('phoneInput');
            const nameInput = document.getElementById('customerNameInput');
            let debounceTimer;
            let lastLookedUp = '';
            let lastAutoFilled = nameInput.value;

            phoneInput.addEventListener('input', function () {
                const phone = phoneInput.value.trim();
                clearTimeout(debounceTimer);

                if (!phone) {
                    lastLookedUp = '';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    lastLookedUp = phone;
                    fetch('@Url.Action("LookupCustomer")?phone=' + encodeURIComponent(phone))
                        .then(r => r.json())
                        .then(data => {
                            if (phoneInput.value.trim() !== lastLookedUp) return;
                            if (nameInput.value !== lastAutoFilled) return;

                            const newValue = data.found ? (data.name || '') : '';
                            nameInput.value = newValue;
                            lastAutoFilled = newValue;
                        });
                }, 500);
            });
        })();
    </script>
}
