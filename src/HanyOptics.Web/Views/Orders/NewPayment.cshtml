@model HanyOptics.BusinessLogic.Models.NewOrderPaymentRequest
@using HanyOptics.Domain.Entities
@{
    ViewData["Title"] = "طلب جديد";
    var order = (Order)ViewBag.Order;
    static string Money(decimal n) => n.ToString("N0") + " ج";
    var frameTotal = order.OrderItems.Sum(i => i.FrameAgreedPrice);
    var lensTotal = order.OrderItems.Sum(i => i.LensSellPrice);
}

<div class="page-header">
    <span class="page-header-title disabled" title="أكمل الطلب الحالي أو ألغه أولاً لبدء طلب جديد">➕ طلب جديد</span>
    <form asp-action="Cancel" method="post" onsubmit="return confirm('سيتم إلغاء هذا الطلب نهائياً. هل أنت متأكد؟');">
        <input type="hidden" name="orderId" value="@order.OrderId" />
        <button type="submit" class="btn btn-outline">إلغاء</button>
    </form>
</div>

<div class="wizard-steps">
    <div class="wizard-step done">
        <div class="step-num">١</div>
        <div class="step-label">العميل</div>
    </div>
    <div class="wizard-step done">
        <div class="step-num">٢</div>
        <div class="step-label">البيانات والروشتة</div>
    </div>
    <div class="wizard-step active">
        <div class="step-num">٣</div>
        <div class="step-label">الدفع والتأكيد</div>
    </div>
</div>

<div class="wizard-content">
    <div class="flex gap-2 mb-3 flex-wrap items-center">
        <span class="info-chip">📄 @order.InvoiceNumber</span>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.CustomerPhone))
        {
            <span class="info-chip">📱 @ViewBag.CustomerPhone</span>
        }
        @if (!string.IsNullOrWhiteSpace(order.CustomerName))
        {
            <span class="info-chip">👤 @order.CustomerName</span>
        }
        <span class="info-chip">📦 @order.OrderItems.Count بند</span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="amount-box">
        <div class="amount-row"><span class="a-label">سعر الإطار</span><span class="a-val">@Money(frameTotal)</span></div>
        <div class="amount-row"><span class="a-label">سعر العدسات</span><span class="a-val">@Money(lensTotal)</span></div>
        <div class="amount-row total"><span class="a-label">إجمالي الطلب</span><span class="a-val">@Money(order.TotalAmount)</span></div>
    </div>

    <div class="section-divider"><span>💳 تسجيل الدفع</span></div>

    <form asp-action="NewPayment" method="post" id="paymentForm">
        <input type="hidden" asp-for="OrderId" />

        <div class="form-group">
            <label>طريقة الدفع</label>
            <select asp-for="PaymentMethod">
                <option value="Cash">💵 نقدي</option>
                <option value="Visa">💳 فيزا / بطاقة</option>
            </select>
        </div>

        <div class="form-group">
            <label>💰 المبلغ المدفوع (ج)</label>
            <input type="number" asp-for="Amount" id="amountInput" min="0" />
            <span asp-validation-for="Amount" class="field-error"></span>
            <div class="form-hint">نوع الدفعة (عربون / كامل / نهائي) بيتحدد تلقائياً حسب المبلغ المتبقي على الطلب</div>
        </div>

        <div class="remaining-box">
            <div class="remaining-label">المتبقي على الزبون</div>
            <div class="remaining-val" id="remainingVal">٠ ج</div>
        </div>

        <div class="wizard-footer">
            <a class="btn btn-outline" asp-action="NewItem" asp-route-orderId="@order.OrderId" asp-route-doctorId="@order.DoctorId">→ رجوع</a>
            <button type="submit" class="btn btn-success btn-lg">✅ تسجيل الطلب</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const remainingBefore = @order.RemainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const amountInput = document.getElementById('amountInput');
            const remainingVal = document.getElementById('remainingVal');

            function update() {
                const paid = +amountInput.value || 0;
                const remaining = Math.max(0, remainingBefore - paid);
                remainingVal.textContent = remaining.toLocaleString('ar-EG') + ' ج';
            }

            amountInput.addEventListener('input', update);
            update();
        })();
    </script>
}
