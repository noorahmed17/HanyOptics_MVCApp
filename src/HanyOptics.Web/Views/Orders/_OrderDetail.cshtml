@using System.Globalization
@using HanyOptics.Domain.Enums
@model HanyOptics.Web.Controllers.Orders.OrderDetailViewModel
@{
    var order = Model.Order;
    var arEg = new CultureInfo("ar-EG");

    static string StatusBadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Sold => "badge-sold",
        OrderStatus.Ready => "badge-ready",
        OrderStatus.Delivered => "badge-delivered",
        OrderStatus.Cancelled => "badge-cancelled",
        _ => ""
    };

    static string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Sold => "بيع",
        OrderStatus.Ready => "جاهز",
        OrderStatus.Delivered => "تسليم",
        OrderStatus.Cancelled => "ملغي",
        _ => s.ToString()
    };

    static string TypeLabel(OrderItemType t) => t switch
    {
        OrderItemType.FrameLenses => "إطار+عدسات",
        OrderItemType.FrameOnly => "إطار فقط",
        OrderItemType.LensesReplace => "استبدال عدسات",
        _ => t.ToString()
    };

    static string TypeBadgeClass(OrderItemType t) => t switch
    {
        OrderItemType.FrameLenses => "badge-fl",
        OrderItemType.FrameOnly => "badge-fo",
        OrderItemType.LensesReplace => "badge-lr",
        _ => ""
    };

    static string PaymentTypeLabel(PaymentType t) => t switch
    {
        PaymentType.Deposit => "عربون",
        PaymentType.Final => "دفعة نهائية",
        PaymentType.Full => "دفع كامل",
        PaymentType.Refund => "استرداد",
        _ => t.ToString()
    };

    static (OrderStatus? Old, OrderStatus New, string Text, string DotClass) LogLine(HanyOptics.Domain.Entities.OrderStatusLog l) => (
        l.OldStatus, l.NewStatus,
        l.NewStatus switch
        {
            OrderStatus.Sold => "تم البيع",
            OrderStatus.Ready => "جاهز للتسليم",
            OrderStatus.Delivered => "تم التسليم",
            OrderStatus.Cancelled => "ملغي",
            _ => l.NewStatus.ToString()
        },
        l.NewStatus switch { OrderStatus.Delivered => "green", OrderStatus.Cancelled => "red", _ => "" }
    );

    // All three target statuses are always offered, regardless of the order's current
    // status - sp_update_order_status is the sole authority on which transitions are
    // actually valid, and rejects anything else with a clear Arabic RAISERROR message
    // (surfaced as-is by CommitPendingEditsAsync). The UI doesn't try to replicate that
    // matrix, so there's only one place the transition rules can ever drift out of date.
    static IReadOnlyList<OrderStatus> NextStatuses(OrderStatus current) =>
        new[] { OrderStatus.Ready, OrderStatus.Delivered, OrderStatus.Cancelled };

    string Money(decimal n) => n.ToString("N0", arEg) + " ج";
    string FormatDateTime(DateTime d) => d.ToString("d MMM, HH:mm", arEg);

    var nextStatuses = NextStatuses(order.Status);

    // sp_swap_frame / sp_assign_compensation_frame themselves block terminal orders and
    // non-active items - this only decides whether to offer the "الإطار تالف" trigger.
    // An item with FrameId set (frame_lenses/frame_only from inventory) swaps via
    // sp_swap_frame; one without (استبدال عدسات, customer's own external frame) gets a
    // compensation frame via sp_assign_compensation_frame instead - same button, same
    // modal, different endpoint underneath (see openSwapModal's mode argument).
    static bool CanReplaceFrame(HanyOptics.Domain.Entities.OrderItem i) =>
        i.Status == OrderItemStatus.Active && (i.FrameId.HasValue || i.ItemType == OrderItemType.LensesReplace);

    var orderIsTerminal = order.Status is OrderStatus.Delivered or OrderStatus.Cancelled;
    var hasSwappableItem = !orderIsTerminal && order.OrderItems.Any(CanReplaceFrame);

    // Same philosophy as CanReplaceFrame: this only decides whether to offer the button.
    // sp_cancel_order_item stays the authority on whether the cancellation is allowed
    // (it also refuses items on a 'ready' order) and rejects with its own Arabic message.
    var activeItemCount = order.OrderItems.Count(i => i.Status == OrderItemStatus.Active);
    var hasCancellableItem = !orderIsTerminal && activeItemCount > 0;

    // إطار فقط has no lens line, so an order made up entirely of those never needs the
    // lens dialog rendered at all.
    var hasLensItem = !orderIsTerminal && order.OrderItems.Any(i =>
        i.Status == OrderItemStatus.Active && i.ItemType != OrderItemType.FrameOnly);

    // A delivered order can still be owed money (handed over on a promise to pay), so the
    // payment button follows what's outstanding rather than the order's status. Cancelled
    // is the one status sp_add_payment refuses anything but a refund on.
    var canTakePayment = order.Status != OrderStatus.Cancelled && order.RemainingAmount > 0;

    // Refunds follow the money, not the status: anything actually collected can be handed
    // back, and a cancelled order is precisely the case that needs it - sp_add_payment
    // accepts nothing but a refund once an order is cancelled.
    var canRefund = order.PaidAmount > 0;
}

<div class="modal-header">
    <span class="modal-title">تفاصيل <bdi>@order.InvoiceNumber</bdi></span>
    <button type="button" class="modal-close" onclick="closeOrderDetail()">✕</button>
</div>

<div class="modal-body">
    @if (ViewBag.PendingEditError is string pendingEditError)
    {
        <div class="alert alert-danger mb-2">⚠️ @pendingEditError</div>
    }

    @* Just the two figures worth seeing at a glance. The rest of the customer/order detail
       that used to sit here was noise - the invoice is in the title, and the money detail
       is in the payment and refund dialogs where it is actually being acted on. *@
    <div class="detail-section">
        <div class="detail-grid">
            <div class="detail-row"><span class="detail-label">الإجمالي</span><span class="detail-val fw-bold c-blue">@Money(order.TotalAmount)</span></div>
            <div class="detail-row"><span class="detail-label">الحالة</span><span class="detail-val"><span class="badge @StatusBadgeClass(order.Status)">@StatusLabel(order.Status)</span></span></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(order.Notes))
    {
        <div class="alert alert-info mb-2">📝 @order.Notes</div>
    }

    @if (Model.PendingEdits.Any())
    {
        <div class="detail-section" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px">
            <h4>⏳ التغييرات المعلقة (@Model.PendingEdits.Count) — لن تُحفظ إلا بعد الضغط على تأكيد</h4>
            @foreach (var edit in Model.PendingEdits)
            {
                <div class="flex items-center gap-2" style="justify-content:space-between;padding:6px 0;border-bottom:1px solid #fef3c7">
                    <span style="font-size:13px">@edit.Summary</span>
                    <form asp-action="RemovePendingEdit" method="post" onsubmit="stageEdit(event)">
                        <input type="hidden" name="orderId" value="@order.OrderId" />
                        <input type="hidden" name="editId" value="@edit.EditId" />
                        <button type="submit" class="btn btn-outline btn-sm" title="إلغاء هذا التغيير">✕</button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="detail-section">
        <h4>
            <span>📦 البنود (@order.OrderItems.Count)</span>
            <span class="flex items-center gap-2">
                @* A full page rather than a modal - this is the same form as wizard step 2.
                   Leaves the popup, so any staged-but-unconfirmed edits are left behind on
                   purpose: they are still in the session when the order is reopened. *@
                @if (!orderIsTerminal)
                {
                    <a class="btn btn-outline btn-sm" asp-action="AddItem" asp-route-id="@order.OrderId">➕ إضافة بند</a>
                }
                @if (nextStatuses.Any())
                {
                    <button type="button" class="btn btn-outline btn-sm" onclick="openStatusModal()">🔄 تحديث الحالة</button>
                }
            </span>
        </h4>

        @foreach (var it in order.OrderItems)
        {
            var frameInfo = it.CompensationFrameId.HasValue
                ? "🔁 إطار تعويضي من المخزون"
                : (!string.IsNullOrWhiteSpace(it.ExternalFrameNotes) ? $"📦 {it.ExternalFrameNotes}" : (it.FrameId.HasValue ? "🗃️ إطار من المخزون" : null));
            var itemCancelled = it.Status != OrderItemStatus.Active;
            <div style="background:@(itemCancelled ? "#f9fafb" : "#f8fafc");border-radius:8px;padding:12px;margin-bottom:10px;border:1px solid #e2e8f0;@(itemCancelled ? "opacity:.65" : "")">
                <div class="flex items-center gap-2 flex-wrap mb-2">
                    <span class="badge @TypeBadgeClass(it.ItemType)">@TypeLabel(it.ItemType)</span>
                    @if (itemCancelled)
                    {
                        <span class="badge badge-cancelled">ملغي</span>
                    }
                    @if (frameInfo is not null)
                    {
                        <span class="info-chip">@frameInfo</span>
                    }
                    <span style="margin-right:auto;font-size:16px;font-weight:800;color:@(itemCancelled ? "#9ca3af" : "#1a56db");@(itemCancelled ? "text-decoration:line-through" : "")">@Money(it.ItemTotal)</span>
                </div>
                @if (it.FrameId.HasValue || it.CompensationFrameId.HasValue || !string.IsNullOrWhiteSpace(it.ExternalFrameNotes))
                {
                    <div class="detail-row"><span class="detail-label">سعر الإطار</span><span class="detail-val">@Money(it.FrameAgreedPrice)</span></div>
                }
                @if (!itemCancelled && !orderIsTerminal)
                {
                    <div class="flex items-center gap-2 flex-wrap mt-2">
                        @if (CanReplaceFrame(it))
                        {
                            var replaceMode = it.FrameId.HasValue ? "swap" : "compensate";
                            <button type="button" class="btn btn-outline btn-sm" onclick="openSwapModal(@it.ItemId, '@TypeLabel(it.ItemType)', @it.FrameAgreedPrice.ToString(System.Globalization.CultureInfo.InvariantCulture), '@replaceMode')">🔄 تغيير الإطار</button>
                        }
                        @* Offered wherever the item actually has a lens line. Nothing to look
                           up - lenses hold no stock - so it asks only for type and price.

                           The values ride on data-* attributes rather than being written into
                           the onclick call: the lens description is free text a user typed,
                           so it can contain quotes or apostrophes that would break out of the
                           attribute. Razor encodes attribute values, so this holds whatever
                           they wrote. *@
                        @if (it.ItemType != OrderItemType.FrameOnly)
                        {
                            <button type="button" class="btn btn-outline btn-sm"
                                    data-lens-item-id="@it.ItemId"
                                    data-lens-item-label="@TypeLabel(it.ItemType)"
                                    data-lens-description="@it.LensDescription"
                                    data-lens-price="@it.LensSellPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    onclick="openLensModal(this)">👁️ تغيير العدسات</button>
                        }
                        <button type="button" class="btn btn-outline btn-sm" onclick="openCancelItemModal(@it.ItemId, '@TypeLabel(it.ItemType)', @it.ItemTotal.ToString(System.Globalization.CultureInfo.InvariantCulture), @(activeItemCount == 1 ? "true" : "false"), @(it.FrameId.HasValue || it.CompensationFrameId.HasValue ? "true" : "false"))" style="color:#dc2626">🗑️ إلغاء البند</button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(it.LensDescription))
                {
                    <div class="detail-row"><span class="detail-label">العدسات</span><span class="detail-val">@it.LensDescription</span></div>
                    <div class="detail-row"><span class="detail-label">سعر العدسات</span><span class="detail-val">@Money(it.LensSellPrice)</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(it.DiscountReason))
                {
                    <div class="detail-row"><span class="detail-label">ملاحظة</span><span class="detail-val text-sm" style="color:#b45309">⚠️ @it.DiscountReason</span></div>
                }
                @if (it.Prescription is not null)
                {
                    var rx = it.Prescription;
                    <div style="margin-top:8px;background:#fff;border-radius:6px;padding:8px 10px;font-size:12px;color:#374151">
                        👁️ <b>الروشتة:</b>
                        يمين: @(rx.RightSphere?.ToString() ?? "—") / @(rx.RightCylinder?.ToString() ?? "—") × @(rx.RightAxis?.ToString() ?? "—")
                        &nbsp;|&nbsp; يسار: @(rx.LeftSphere?.ToString() ?? "—") / @(rx.LeftCylinder?.ToString() ?? "—") × @(rx.LeftAxis?.ToString() ?? "—")
                        @(rx.Pd.HasValue ? $" | PD: {rx.Pd}" : "") @(rx.AddPower.HasValue ? $" | ADD: {rx.AddPower}" : "")
                    </div>
                }
            </div>
        }
    </div>

    <div class="detail-section">
        <h4>
            <span>💳 المدفوعات</span>
            @* The order-detail popup was read-only for money until now: the only payment
               screen was step 3 of the new-order wizard, so a customer returning to settle
               the rest had nowhere to be recorded. sp_add_payment always supported it. *@
            <span class="flex items-center gap-2">
                @if (canTakePayment)
                {
                    <button type="button" class="btn btn-outline btn-sm" onclick="openPaymentModal()">➕ تسجيل دفعة</button>
                }
                @if (canRefund)
                {
                    <button type="button" class="btn btn-outline btn-sm" onclick="openRefundModal()" style="color:#dc2626">↩️ استرداد</button>
                }
            </span>
        </h4>
        @if (canTakePayment)
        {
            <div class="alert alert-warning mb-2">💰 المتبقي على الزبون: <b>@Money(order.RemainingAmount)</b></div>
        }
        @if (!order.Payments.Any())
        {
            <div class="text-muted text-sm">لا توجد مدفوعات</div>
        }
        else
        {
            @foreach (var p in order.Payments.OrderBy(p => p.PaidAt))
            {
                <div class="payment-row">
                    <span class="payment-amount @(p.PaymentType == PaymentType.Refund ? "refund" : "")">@(p.PaymentType == PaymentType.Refund ? "-" : "+")@Money(p.Amount)</span>
                    <span class="payment-info">
                        @PaymentTypeLabel(p.PaymentType) — @FormatDateTime(p.PaidAt)
                        <span class="badge @(p.PaymentMethod == PaymentMethod.Cash ? "badge-cash" : "badge-visa")">@(p.PaymentMethod == PaymentMethod.Cash ? "نقدي" : "فيزا")</span>
                    </span>
                </div>
            }
        }
    </div>

    <div class="detail-section">
        <h4>📅 سجل الحالات</h4>
        <div class="timeline">
            @foreach (var l in order.StatusLogs.OrderBy(l => l.ChangedAt))
            {
                var (_, _, text, dotClass) = LogLine(l);
                <div class="tl-item">
                    <div class="tl-dot @dotClass"></div>
                    <div class="tl-time">@FormatDateTime(l.ChangedAt)</div>
                    <div class="tl-text">@text</div>
                    @if (!string.IsNullOrWhiteSpace(l.Notes))
                    {
                        <div class="tl-note">@l.Notes</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline" onclick="closeOrderDetail()">إغلاق</button>
    @if (Model.PendingEdits.Any())
    {
        <form id="confirmEditsForm" asp-action="ConfirmPendingEdits" method="post" style="display:contents">
            <input type="hidden" name="orderId" value="@order.OrderId" />
            <button type="submit" class="btn btn-primary">تأكيد (@Model.PendingEdits.Count)</button>
        </form>
    }
</div>

@if (nextStatuses.Any())
{
    <div class="overlay" id="statusModalOverlay" style="z-index:110" onclick="closeStatusModal()"></div>
    <div class="modal modal-sm" id="statusModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">🔄 تغيير الحالة</span>
            <button type="button" class="modal-close" onclick="closeStatusModal()">✕</button>
        </div>
        <div class="modal-body">
            <form id="statusForm" asp-action="StageStatusChange" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />
                <div class="form-group">
                    <label>الحالة الجديدة</label>
                    <select name="newStatus" required>
                        <option value="" selected disabled>-- اختر الحالة --</option>
                        @foreach (var s in nextStatuses)
                        {
                            <option value="@s">@StatusLabel(s)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>ملاحظة (اختياري)</label>
                    <input type="text" name="notes" placeholder="مثال: العدسات وصلت من المورد" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeStatusModal()">إلغاء</button>
            <button type="submit" form="statusForm" class="btn btn-primary">إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}

@if (hasSwappableItem)
{
    <div class="overlay" id="swapModalOverlay" style="z-index:110" onclick="closeSwapModal()"></div>
    <div class="modal modal-sm" id="swapModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">🔄 تغيير الإطار</span>
            <button type="button" class="modal-close" onclick="closeSwapModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info mb-2" id="swapItemLabel"></div>
            <form id="swapForm" asp-action="StageFrameSwap" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />
                <input type="hidden" name="itemId" id="swapItemId" />
                <input type="hidden" name="newFrameId" id="swapNewFrameId" />

                @* Decides sp_swap_frame's @old_frame_disposition. Defaults to returning the
                   old frame to stock: writing a frame off is the destructive option and
                   should be chosen deliberately, not fallen into. Hidden for compensation
                   items, which have no old frame to dispose of. *@
                <div class="form-group" id="swapReasonGroup">
                    <label>سبب التغيير *</label>
                    <select name="returnOldFrameToStock" id="swapReason" onchange="updateSwapReasonHint()" required>
                        <option value="true" selected>🔄 الزبون غيّر رأيه — الإطار سليم</option>
                        <option value="false">⚠️ الإطار تالف</option>
                    </select>
                    <div class="text-sm text-muted mt-1" id="swapReasonHint"></div>
                </div>
                @* Only asked when the old frame is coming back intact. A damaged frame is
                   replaced from stock by definition - there is nothing to choose - so this
                   stays hidden for تالف, and for compensation items too. When the customer
                   supplies the frame, sp_swap_frame takes @new_frame_id = NULL, dropping the
                   item off inventory and turning it into استبدال عدسات. *@
                <div class="form-group" id="swapSourceGroup">
                    <label>مصدر الإطار الجديد *</label>
                    <select id="swapSource" onchange="updateSwapSource()">
                        <option value="stock" selected>🗃️ إطار من المخزون</option>
                        <option value="external">📦 إطار الزبون (جابه معاه)</option>
                    </select>
                </div>

                <div id="swapInventoryGroup">
                    <div class="form-group">
                        <label>باركود الإطار البديل *</label>
                        <div class="input-group">
                            <input type="text" id="swapBarcodeInput" placeholder="HO-2026-XXXXX أو اسكان الباركود" />
                            <button type="button" class="btn btn-primary" onclick="searchSwapFrame()">🔍 بحث</button>
                        </div>
                        <div class="frame-result" id="swapFrameResult">
                            <div class="frame-result-title">✅ إطار موجود ومتاح</div>
                            <div class="frame-meta" id="swapFrameMeta"></div>
                        </div>
                        <div class="frame-error" id="swapFrameError"></div>
                    </div>
                </div>

                <div id="swapExternalGroup" style="display:none">
                    <div class="form-group">
                        <label>وصف إطار الزبون (اختياري)</label>
                        <input type="text" name="externalFrameNotes" id="swapExternalNotesInput" placeholder="مثال: إطار Gucci أسود — جابه من عنده" />
                        <div class="form-hint">البند هيتحول إلى «استبدال عدسات» ومش هياخد إطار من المخزون.</div>
                    </div>
                </div>

                @* Hidden when the customer brings their own frame: we are not selling one,
                   so there is no price to agree. sp_swap_frame still needs the parameter,
                   and 0 is what it is sent. *@
                <div class="form-group" id="swapPriceGroup">
                    <label>💰 السعر المتفق مع الزبون (ج) *</label>
                    <input type="number" name="newFrameAgreedPrice" id="swapPriceInput" min="0" step="0.01" required />
                </div>
                <div class="form-group">
                    <label>ملاحظة (اختياري)</label>
                    <input type="text" name="notes" id="swapNotesInput" placeholder="مثال: الزبون فضّل موديل أخف" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeSwapModal()">إلغاء</button>
            <button type="submit" form="swapForm" id="swapConfirmBtn" class="btn btn-primary" disabled>إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}

@if (canTakePayment)
{
    <div class="overlay" id="paymentModalOverlay" style="z-index:110" onclick="closePaymentModal()"></div>
    <div class="modal modal-sm" id="paymentModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">💳 تسجيل دفعة</span>
            <button type="button" class="modal-close" onclick="closePaymentModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info mb-2">
                الإجمالي: <b>@Money(order.TotalAmount)</b> — المدفوع: <b>@Money(order.PaidAmount)</b> — المتبقي: <b>@Money(order.RemainingAmount)</b>
            </div>

            <form id="paymentForm" asp-action="StagePayment" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />

                <div class="form-group">
                    <label>💰 المبلغ (ج) *</label>
                    <input type="number" name="amount" id="paymentAmountInput" min="0.01" step="0.01"
                           max="@order.RemainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                    @* Saves retyping the common case - the customer settling up in full. *@
                    <button type="button" class="btn btn-outline btn-sm mt-1"
                            onclick="document.getElementById('paymentAmountInput').value = '@order.RemainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)'">
                        سداد المتبقي بالكامل (@Money(order.RemainingAmount))
                    </button>
                </div>

                <div class="form-group">
                    <label>طريقة الدفع *</label>
                    <select name="paymentMethod" required>
                        <option value="Cash" selected>💵 نقدي</option>
                        <option value="Visa">💳 فيزا</option>
                    </select>
                </div>

                @* نوع الدفعة (عربون / دفعة نهائية / دفع كامل) is derived at commit time from
                   what is actually owed then - staff never pick it, same as the wizard. *@
                <div class="form-group">
                    <label>ملاحظة (اختياري)</label>
                    <input type="text" name="notes" placeholder="مثال: استلم الأوردر ودفع الباقي" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closePaymentModal()">إلغاء</button>
            <button type="submit" form="paymentForm" class="btn btn-primary">إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}

@if (hasLensItem)
{
    <div class="overlay" id="lensModalOverlay" style="z-index:110" onclick="closeLensModal()"></div>
    <div class="modal modal-sm" id="lensModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">👁️ تغيير العدسات</span>
            <button type="button" class="modal-close" onclick="closeLensModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info mb-2" id="lensItemLabel"></div>

            <form id="lensForm" asp-action="StageLensChange" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />
                <input type="hidden" name="itemId" id="lensItemId" />

                @* No barcode and no availability check: lenses are not stocked, so the type
                   is free text and the price is whatever was agreed. *@
                <div class="form-group">
                    <label>👁️ نوع العدسات *</label>
                    <input type="text" name="lensDescription" id="lensDescriptionInput"
                           placeholder="مثال: عدسات أحادية 1.67 AR — Essilor" required />
                </div>

                <div class="form-group">
                    <label>💰 سعر العدسات (ج) *</label>
                    <input type="number" name="lensSellPrice" id="lensPriceInput" min="0" step="0.01" required />
                    <div class="text-sm text-muted mt-1" id="lensPriceHint"></div>
                </div>

                <div class="form-group">
                    <label>ملاحظة (اختياري)</label>
                    <input type="text" name="notes" id="lensNotesInput" placeholder="مثال: الزبون طلب خامة أعلى" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeLensModal()">إلغاء</button>
            <button type="submit" form="lensForm" class="btn btn-primary">إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}

@if (canRefund)
{
    <div class="overlay" id="refundModalOverlay" style="z-index:110" onclick="closeRefundModal()"></div>
    <div class="modal modal-sm" id="refundModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">↩️ استرداد مبلغ</span>
            <button type="button" class="modal-close" onclick="closeRefundModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info mb-2">
                المدفوع فعلاً: <b>@Money(order.PaidAmount)</b> — الإجمالي: <b>@Money(order.TotalAmount)</b>
            </div>

            <form id="refundForm" asp-action="StageRefund" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />

                <div class="form-group">
                    <label>💰 مبلغ الاسترداد (ج) *</label>
                    <input type="number" name="amount" id="refundAmountInput" min="0.01" step="0.01"
                           max="@order.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                    <button type="button" class="btn btn-outline btn-sm mt-1"
                            onclick="document.getElementById('refundAmountInput').value = '@order.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)'">
                        رد كامل المدفوع (@Money(order.PaidAmount))
                    </button>
                    <div class="form-hint">لا يمكن رد أكثر من المدفوع فعلاً.</div>
                </div>

                <div class="form-group">
                    <label>طريقة الرد *</label>
                    <select name="paymentMethod" required>
                        <option value="Cash" selected>💵 نقدي</option>
                        <option value="Visa">💳 فيزا</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>سبب الاسترداد (اختياري)</label>
                    <input type="text" name="notes" placeholder="مثال: إلغاء الطلب بناءً على طلب الزبون" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeRefundModal()">إلغاء</button>
            <button type="submit" form="refundForm" class="btn btn-danger">إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}

@if (hasCancellableItem)
{
    <div class="overlay" id="cancelItemModalOverlay" style="z-index:110" onclick="closeCancelItemModal()"></div>
    <div class="modal modal-sm" id="cancelItemModal" style="z-index:111" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span class="modal-title">🗑️ إلغاء بند</span>
            <button type="button" class="modal-close" onclick="closeCancelItemModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info mb-2" id="cancelItemLabel"></div>

            @* Shown only when this is the order's last active item - sp_cancel_order_item
               cancels the whole order at that point, which is worth saying before staging. *@
            <div class="alert alert-warning mb-2" id="cancelItemLastWarning" style="display:none">
                ⚠️ هذا آخر بند نشط في الطلب — إلغاؤه سيؤدي إلى إلغاء الطلب بالكامل.
            </div>

            <form id="cancelItemForm" asp-action="StageItemCancellation" method="post" onsubmit="stageEdit(event)">
                <input type="hidden" name="orderId" value="@order.OrderId" />
                <input type="hidden" name="itemId" id="cancelItemId" />

                @* Only meaningful when the item actually has a frame; for استبدال عدسات with
                   no frame either choice is a no-op on stock, so the picker is hidden and
                   the SP's default ('return') applies. *@
                <div class="form-group" id="cancelDispositionGroup">
                    <label>ماذا يحدث للإطار؟ *</label>
                    <select name="disposition" id="cancelDisposition" onchange="updateCancelDispositionHint()" required>
                        <option value="Return" selected>↩️ إرجاع الإطار للمخزون (سليم)</option>
                        <option value="Damage">💥 الإطار تالف — شطب من المخزون</option>
                    </select>
                    <div class="text-sm text-muted mt-1" id="cancelDispositionHint"></div>
                </div>

                <div class="form-group">
                    <label>سبب الإلغاء / ملاحظة (اختياري)</label>
                    <input type="text" name="notes" placeholder="مثال: الزبون غيّر رأيه" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeCancelItemModal()">تراجع</button>
            <button type="submit" form="cancelItemForm" class="btn btn-danger">إضافة للتغييرات المعلقة</button>
        </div>
    </div>
}
