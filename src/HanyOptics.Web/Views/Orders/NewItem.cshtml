@model HanyOptics.BusinessLogic.Models.NewOrderItemRequest
@using HanyOptics.BusinessLogic.Models
@using HanyOptics.Web.Controllers.Orders
@{
    ViewData["Title"] = "طلب جديد";
    var doctors = (SelectListWithSelection)ViewBag.Doctors;
    // The order doesn't exist in the database yet - everything shown here comes from the
    // draft held in the session until step 3 is submitted.
    var draft = (OrderDraft)ViewBag.Draft;

    static string TypeLabel(HanyOptics.Domain.Enums.OrderItemType t) => t switch
    {
        HanyOptics.Domain.Enums.OrderItemType.FrameLenses => "إطار+عدسات",
        HanyOptics.Domain.Enums.OrderItemType.FrameOnly => "إطار فقط",
        HanyOptics.Domain.Enums.OrderItemType.LensesReplace => "استبدال عدسات",
        _ => t.ToString()
    };
    static string TypeBadgeClass(HanyOptics.Domain.Enums.OrderItemType t) => t switch
    {
        HanyOptics.Domain.Enums.OrderItemType.FrameLenses => "badge-fl",
        HanyOptics.Domain.Enums.OrderItemType.FrameOnly => "badge-fo",
        HanyOptics.Domain.Enums.OrderItemType.LensesReplace => "badge-lr",
        _ => ""
    };
    static string Money(decimal n) => n.ToString("N0") + " ج";
}

<div class="page-header">
    <span class="page-header-title disabled" title="أكمل الطلب الحالي أو ألغه أولاً لبدء طلب جديد">➕ طلب جديد</span>
    <form asp-action="Cancel" method="post" onsubmit="return confirm('سيتم إلغاء هذا الطلب. هل أنت متأكد؟');">
        <button type="submit" class="btn btn-outline">إلغاء</button>
    </form>
</div>

<div class="wizard-steps">
    <div class="wizard-step done">
        <div class="step-num">١</div>
        <div class="step-label">العميل</div>
    </div>
    <div class="wizard-step active">
        <div class="step-num">٢</div>
        <div class="step-label">البيانات والروشتة</div>
    </div>
    <div class="wizard-step">
        <div class="step-num">٣</div>
        <div class="step-label">الدفع والتأكيد</div>
    </div>
</div>

<div class="wizard-content">
    <div class="flex gap-2 mb-3 flex-wrap items-center">
        <span class="info-chip">📄 <bdi>@draft.InvoiceNumber</bdi></span>
        @if (!string.IsNullOrWhiteSpace(draft.Phone))
        {
            <span class="info-chip">📱 @draft.Phone</span>
        }
        @if (!string.IsNullOrWhiteSpace(draft.CustomerName))
        {
            <span class="info-chip">👤 @draft.CustomerName</span>
        }
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (draft.Items.Any())
    {
        <div id="itemsListSection" style="margin-bottom:20px">
            <div style="font-size:13px;font-weight:700;color:#374151;margin-bottom:8px">✅ البنود المضافة</div>
            @foreach (var item in draft.Items)
            {
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
                    <div>
                        <span class="badge @TypeBadgeClass(item.ItemType)" style="margin-left:6px">@TypeLabel(item.ItemType)</span>
                        <span style="font-size:13px;font-weight:600">@(item.FrameLabel ?? item.ExternalFrameNotes ?? item.LensDescription ?? "—")</span>
                    </div>
                    <span style="font-size:15px;font-weight:800;color:#1a56db">@Money(item.ItemTotal)</span>
                </div>
            }
            <div style="background:#eff6ff;border-radius:8px;padding:10px 14px;margin-top:8px;display:flex;justify-content:space-between;align-items:center">
                <span style="font-size:13px;color:#1e40af">إجمالي البنود حتى الآن</span>
                <span style="font-size:18px;font-weight:800;color:#1a56db">@Money(draft.TotalAmount)</span>
            </div>
        </div>
    }

    <form asp-action="NewItem" method="post" id="itemForm">
        <input type="hidden" asp-for="DoctorId" />

        <div class="form-group">
            <label>👤 اسم الزبون على الفاتورة </label>
            <input asp-for="CustomerNameOnInvoice" placeholder="الاسم اللي هيتطبع على الفاتورة" />
            @* <div class="form-hint">ممكن يختلف عن اسم السجل — مثال: أحمد ماهر (ابن الزبون المسجّل)</div> *@
        </div>

        <partial name="_ItemFormFields" model="Model" />

        <div class="wizard-footer">
            <a class="btn btn-outline" asp-action="New">→ رجوع</a>
            <div class="flex gap-2">
                <button type="submit" name="SubmitAction" value="add" class="btn btn-outline" title="أضف هذا البند وابدأ بند جديد">+ إضافة بند آخر</button>
                <button type="submit" name="SubmitAction" value="next" class="btn btn-primary btn-lg">التالي — الدفع ←</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/order-item-form.js" asp-append-version="true"></script>
}
