@using System.Globalization
@using HanyOptics.Domain.Enums
@model IReadOnlyList<HanyOptics.BusinessLogic.Models.OrderListItem>
@{
    ViewData["Title"] = "الطلبات";
    var statusFilter = (OrderStatus?)ViewBag.StatusFilter;
    var deliveryFilter = (DeliveryType?)ViewBag.DeliveryFilter;

    string TabUrl(OrderStatus? s) => Url.Action("Index", new { status = s?.ToString(), deliveryType = deliveryFilter?.ToString() })!;
}

<div class="page-header">
    <h2>الطلبات</h2>
    <a class="btn btn-primary" asp-action="New">➕ طلب جديد</a>
</div>

<div class="text-sm text-muted" style="margin-bottom:10px">🕐 يعرض طلبات آخر 4 أيام فقط</div>

@if (TempData["StatusUpdateError"] is string statusError)
{
    <div class="alert alert-danger">⚠️ @statusError</div>
}

@if (TempData["BulkStatusMessage"] is string bulkMessage)
{
    <div class="alert alert-success">✅ @bulkMessage</div>
}

<div style="margin-bottom:14px">
    <input type="text" id="orderSearch" placeholder="بحث بالفاتورة أو الاسم أو التليفون..." style="max-width:340px" />
</div>

<div class="flex items-center gap-2 flex-wrap" style="justify-content:space-between">
    <div class="tabs">
        <a class="tab @(statusFilter is null ? "active" : "")" href="@TabUrl(null)">الكل</a>
        <a class="tab @(statusFilter == OrderStatus.Sold ? "active" : "")" href="@TabUrl(OrderStatus.Sold)">بيع</a>
        <a class="tab @(statusFilter == OrderStatus.Ready ? "active" : "")" href="@TabUrl(OrderStatus.Ready)">جاهز</a>
        <a class="tab @(statusFilter == OrderStatus.Delivered ? "active" : "")" href="@TabUrl(OrderStatus.Delivered)">تسليم</a>
        <a class="tab @(statusFilter == OrderStatus.Cancelled ? "active" : "")" href="@TabUrl(OrderStatus.Cancelled)">ملغي</a>
    </div>

    <form asp-action="Index" method="get" id="deliveryFilterForm" class="mb-3">
        <input type="hidden" name="status" value="@statusFilter" />
        <select name="deliveryType" onchange="document.getElementById('deliveryFilterForm').submit()" style="width:170px">
            <option value="">كل أنواع التسليم</option>
            <option value="Normal" selected="@(deliveryFilter == DeliveryType.Normal)">🚚 عادي</option>
            <option value="Immediate" selected="@(deliveryFilter == DeliveryType.Immediate)">⚡ فوري</option>
        </select>
    </form>
</div>

<div id="bulkToolbar" class="card" style="display:none; margin-bottom:14px">
    <div class="card-body" style="padding:10px 16px">
        <div class="flex items-center gap-2" style="justify-content:space-between">
            <span><b id="bulkSelectedCount">0</b> طلب محدد</span>
            <div class="flex items-center gap-2">
            <select id="bulkStatusSelect" style="width:150px">
                <option value="Sold">بيع</option>
                <option value="Ready">جاهز</option>
                <option value="Delivered">تسليم</option>
                <option value="Cancelled">ملغي</option>
            </select>
                <button type="button" class="btn btn-primary btn-sm" onclick="submitBulkStatusUpdate()">تحديث الحالة</button>
                <button type="button" class="btn btn-outline btn-sm" onclick="clearBulkSelection()">إلغاء التحديد</button>
            </div>
        </div>

        @* The selection outlives both the search and the status tabs, so some of what is
           selected is usually not on screen. Listing the invoices makes the batch about to
           be updated visible in full, instead of a count for rows the user cannot see. *@
        <div class="flex items-center gap-2 flex-wrap mt-2" id="bulkSelectedChips"></div>
    </div>
</div>

<form asp-action="BulkUpdateStatus" method="post" id="bulkStatusForm" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="status" value="@statusFilter" />
    <input type="hidden" name="deliveryType" value="@deliveryFilter" />
    <input type="hidden" name="newStatus" id="bulkNewStatus" />
</form>

<div class="card">
    <div class="card-body">
        <table id="ordersTable">
            <thead>
                <tr>
                    <th style="width:32px"><input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)" /></th>
                    <th>الفاتورة</th>
                    <th>العميل</th>
                    <th>النوع</th>
                    <th>الإجمالي</th>
                    <th>المدفوع</th>
                    <th>المتبقي</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody">
                <partial name="_OrdersTableRows" model="Model" />
            </tbody>
        </table>
    </div>
</div>

<div class="overlay" id="orderDetailOverlay" onclick="closeOrderDetail()"></div>
<div class="modal" id="orderDetailModal" onclick="event.stopPropagation()"></div>

@section Scripts {
    <script>
        // Selection is kept outside the DOM and outside this page load, as id -> invoice
        // number. Two different things used to lose it:
        //
        //   - searching replaces the tbody, taking the checkboxes with it;
        //   - the status tabs (بيع / جاهز / تسليم) are ordinary links, so clicking one is
        //     a full page load and every bit of in-memory state went with it.
        //
        // Gathering a batch means moving between those views on purpose - find one order by
        // invoice, another under جاهز, a third under بيع - so the selection has to survive
        // both. sessionStorage is what makes it outlast the navigation; it is scoped to this
        // browser tab and disappears when the tab closes, which is the right lifetime for a
        // selection in progress.
        const BULK_SELECTION_KEY = 'hanyoptics.bulkSelection';

        function loadSelection() {
            try {
                return new Map(JSON.parse(sessionStorage.getItem(BULK_SELECTION_KEY) || '[]'));
            } catch {
                return new Map();
            }
        }

        function saveSelection() {
            try {
                sessionStorage.setItem(BULK_SELECTION_KEY, JSON.stringify(Array.from(selectedOrders)));
            } catch {
                // Private-browsing quota errors must not break selecting; the selection just
                // stops surviving navigation.
            }
        }

        const selectedOrders = loadSelection();

        function syncCheckboxesWithSelection() {
            const checkboxes = document.querySelectorAll('.order-select-checkbox');
            checkboxes.forEach(function (cb) { cb.checked = selectedOrders.has(cb.value); });

            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) selectAll.checked = checkboxes.length > 0 && Array.from(checkboxes).every(function (cb) { return cb.checked; });

            updateBulkToolbar();
        }

        // The table only ever loads the default last-4-days window (see Index), so
        // filtering the rows already in the DOM can never find an older order. Typing
        // instead asks the server (SearchOrders, no fromDate) so a match anywhere in
        // time turns up and can be selected for bulk status updates like any other row.
        // Clearing the box restores the original last-4-days rows from cache rather than
        // re-fetching, since that's exactly what was there before searching started.
        (function () {
            const input = document.getElementById('orderSearch');
            const tbody = document.getElementById('ordersTableBody');
            if (!input || !tbody) return;

            const initialHtml = tbody.innerHTML;
            let debounceTimer = null;

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const term = input.value.trim();

                if (!term) {
                    tbody.innerHTML = initialHtml;
                    syncCheckboxesWithSelection();
                    return;
                }

                debounceTimer = setTimeout(function () {
                    const params = new URLSearchParams({ term: term, status: '@statusFilter', deliveryType: '@deliveryFilter' });
                    fetch('@Url.Action("SearchOrders")?' + params.toString())
                        .then(r => r.ok ? r.text() : Promise.reject())
                        .then(function (html) {
                            tbody.innerHTML = html;
                            syncCheckboxesWithSelection();
                        })
                        .catch(function () {
                            tbody.innerHTML = '<tr><td colspan="8" class="empty-state">تعذر البحث — حاول مرة أخرى</td></tr>';
                        });
                }, 300);
            });
        })();

        // Row-selection toolbar - lets staff update several orders' status in one go
        // instead of opening each order's popup individually. Selection is submitted as
        // a plain POST (not AJAX like the popup's staged edits) because a full redirect
        // back to Index is exactly what's wanted here: the table needs to re-render with
        // the now-updated statuses.
        function onOrderCheckboxChange(checkbox) {
            if (checkbox.checked) selectedOrders.set(checkbox.value, checkbox.dataset.invoice || checkbox.value);
            else selectedOrders.delete(checkbox.value);

            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll && !checkbox.checked) selectAll.checked = false;

            saveSelection();
            updateBulkToolbar();
        }

        function updateBulkToolbar() {
            document.getElementById('bulkSelectedCount').textContent = selectedOrders.size;
            document.getElementById('bulkToolbar').style.display = selectedOrders.size > 0 ? '' : 'none';

            // Each selected order is named, and removable from here - the row it came from
            // may well be behind a different tab or a cleared search by now.
            const chips = document.getElementById('bulkSelectedChips');
            chips.innerHTML = '';
            selectedOrders.forEach(function (invoice, id) {
                const chip = document.createElement('span');
                chip.className = 'info-chip';
                chip.innerHTML = '<bdi></bdi> <b style="cursor:pointer;color:#dc2626">✕</b>';
                chip.querySelector('bdi').textContent = invoice;
                chip.querySelector('b').onclick = function () { deselectOrder(id); };
                chips.appendChild(chip);
            });
        }

        function deselectOrder(id) {
            selectedOrders.delete(id);
            const cb = document.querySelector('.order-select-checkbox[value="' + id + '"]');
            if (cb) cb.checked = false;
            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) selectAll.checked = false;
            saveSelection();
            updateBulkToolbar();
        }

        function toggleSelectAll(checkbox) {
            document.querySelectorAll('.order-select-checkbox').forEach(function (cb) {
                if (checkbox.checked) selectedOrders.set(cb.value, cb.dataset.invoice || cb.value);
                else selectedOrders.delete(cb.value);
                cb.checked = checkbox.checked;
            });
            saveSelection();
            updateBulkToolbar();
        }

        function clearBulkSelection() {
            selectedOrders.clear();
            document.querySelectorAll('.order-select-checkbox').forEach(function (cb) { cb.checked = false; });
            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) selectAll.checked = false;
            saveSelection();
            updateBulkToolbar();
        }

        const BULK_STATUS_LABELS = { Sold: 'بيع', Ready: 'جاهز', Delivered: 'تسليم', Cancelled: 'ملغي' };

        function submitBulkStatusUpdate() {
            if (selectedOrders.size === 0) return;

            const statusValue = document.getElementById('bulkStatusSelect').value;
            const label = BULK_STATUS_LABELS[statusValue] || statusValue;
            // Same reason the chips use <bdi>: an invoice number is digits and hyphens, so
            // inside this Arabic confirm text the browser reorders its groups and
            // 150-999-45 reads as 45-999-150. A native confirm() takes no markup, so the
            // isolation has to be the characters <bdi> is shorthand for.
            const LRI = '⁦', PDI = '⁩';
            const invoices = Array.from(selectedOrders.values()).map(function (n) { return LRI + n + PDI; }).join('، ');
            if (!confirm('تحديث حالة ' + selectedOrders.size + ' طلب إلى: ' + label + '؟\n\n' + invoices)) return;

            const form = document.getElementById('bulkStatusForm');
            document.getElementById('bulkNewStatus').value = statusValue;

            form.querySelectorAll('.bulk-order-id-input').forEach(function (el) { el.remove(); });
            selectedOrders.forEach(function (invoice, id) {
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'orderIds';
                hidden.className = 'bulk-order-id-input';
                hidden.value = id;
                form.appendChild(hidden);
            });

            // Cleared before submitting rather than after the redirect: the batch has left
            // the page, so keeping it selected would invite updating the same orders twice.
            sessionStorage.removeItem(BULK_SELECTION_KEY);
            form.submit();
        }

        function openOrderDetail(id) {
            fetch('@Url.Action("Detail")?id=' + id)
                .then(r => r.ok ? r.text() : Promise.reject())
                .then(html => {
                    document.getElementById('orderDetailModal').innerHTML = html;
                    document.getElementById('orderDetailOverlay').classList.add('show');
                    document.getElementById('orderDetailModal').classList.add('show');
                })
                .catch(() => alert('تعذر تحميل تفاصيل الطلب'));
        }

        function closeOrderDetail() {
            document.getElementById('orderDetailOverlay').classList.remove('show');
            document.getElementById('orderDetailModal').classList.remove('show');
        }

        // Staging a change (تحديث الحالة / الإطار تالف / removing a pending edit) posts in
        // the background and swaps the response straight into the still-open popup -
        // never a real page navigation, so the popup itself never closes and reopens.
        // Only the outer تأكيد (a plain, un-intercepted submit) actually leaves the page,
        // because closing on a successful commit is the one point that's meant to happen.
        function stageEdit(event) {
            event.preventDefault();
            const form = event.target;
            fetch(form.action, { method: 'POST', body: new FormData(form) })
                .then(r => r.ok ? r.text() : Promise.reject())
                .then(html => { document.getElementById('orderDetailModal').innerHTML = html; })
                .catch(() => alert('حدث خطأ غير متوقع — حاول مرة أخرى'));
        }

        function openPaymentModal() {
            document.getElementById('paymentForm').reset();
            document.getElementById('paymentModalOverlay').classList.add('show');
            document.getElementById('paymentModal').classList.add('show');
            document.getElementById('paymentAmountInput').focus();
        }

        function closePaymentModal() {
            document.getElementById('paymentModalOverlay').classList.remove('show');
            document.getElementById('paymentModal').classList.remove('show');
        }

        // Takes the button rather than the values: the lens description is free text, and
        // passing it through an inline onclick argument breaks the attribute as soon as it
        // contains a quote. Reading it off the element sidesteps the quoting entirely.
        //
        // Pre-filled with what the item currently has, so the common case - correcting a
        // price, upgrading the coating - is an edit rather than retyping from blank.
        function openLensModal(button) {
            const d = button.dataset;

            document.getElementById('lensItemLabel').textContent =
                'تغيير عدسات البند: ' + d.lensItemLabel + ' — السعر الحالي: ' + Number(d.lensPrice).toLocaleString('ar-EG') + ' ج';
            document.getElementById('lensItemId').value = d.lensItemId;
            document.getElementById('lensDescriptionInput').value = d.lensDescription || '';
            document.getElementById('lensPriceInput').value = d.lensPrice;
            document.getElementById('lensNotesInput').value = '';
            document.getElementById('lensPriceHint').textContent =
                'إجمالي البند بيتحدث تلقائيًا، وكذلك إجمالي الطلب.';
            document.getElementById('lensModalOverlay').classList.add('show');
            document.getElementById('lensModal').classList.add('show');
            document.getElementById('lensDescriptionInput').focus();
        }

        function closeLensModal() {
            document.getElementById('lensModalOverlay').classList.remove('show');
            document.getElementById('lensModal').classList.remove('show');
        }

        function openRefundModal() {
            document.getElementById('refundForm').reset();
            document.getElementById('refundModalOverlay').classList.add('show');
            document.getElementById('refundModal').classList.add('show');
            document.getElementById('refundAmountInput').focus();
        }

        function closeRefundModal() {
            document.getElementById('refundModalOverlay').classList.remove('show');
            document.getElementById('refundModal').classList.remove('show');
        }

        function openStatusModal() {
            document.getElementById('statusModalOverlay').classList.add('show');
            document.getElementById('statusModal').classList.add('show');
        }

        function closeStatusModal() {
            document.getElementById('statusModalOverlay').classList.remove('show');
            document.getElementById('statusModal').classList.remove('show');
        }

        // 'swap' items already have an inventory frame (sp_swap_frame swaps it out).
        // 'compensate' items never had one - استبدال عدسات with the customer's own
        // external frame - so a replacement is assigned from stock via
        // sp_assign_compensation_frame instead. Same modal either way; only the form's
        // target action changes.
        const SWAP_DAMAGED_FRAME_URL = '@Url.Action("StageFrameSwap")';
        const ASSIGN_COMPENSATION_FRAME_URL = '@Url.Action("StageFrameCompensation")';

        function openSwapModal(itemId, itemLabel, currentPrice, mode) {
            const compensating = mode === 'compensate';

            document.getElementById('swapItemLabel').textContent =
                (compensating ? 'تعيين إطار للبند: ' : 'تغيير إطار البند: ')
                + itemLabel + ' — السعر الحالي: ' + Number(currentPrice).toLocaleString('ar-EG') + ' ج';
            document.getElementById('swapForm').action = compensating ? ASSIGN_COMPENSATION_FRAME_URL : SWAP_DAMAGED_FRAME_URL;
            document.getElementById('swapItemId').value = itemId;
            document.getElementById('swapNewFrameId').value = '';
            document.getElementById('swapBarcodeInput').value = '';
            document.getElementById('swapPriceInput').value = '';

            // A compensation item never had a frame, so there is no old one to send back to
            // stock or write off - the reason picker would be meaningless there.
            const reasonGroup = document.getElementById('swapReasonGroup');
            const reason = document.getElementById('swapReason');
            reasonGroup.style.display = compensating ? 'none' : '';
            reason.disabled = compensating;
            reason.value = 'true';

            // Assigning a compensation frame always draws one from stock. Recorded on the
            // element so updateSwapReasonHint - which owns whether the source picker shows -
            // can honour it without re-deriving the mode.
            const source = document.getElementById('swapSource');
            source.disabled = compensating;
            if (compensating) source.dataset.compensating = '1';
            else delete source.dataset.compensating;

            document.getElementById('swapExternalNotesInput').value = '';
            document.getElementById('swapNotesInput').value = '';
            document.getElementById('swapFrameResult').classList.remove('show');
            document.getElementById('swapFrameError').classList.remove('show');

            // Cascades: reason -> whether the source picker shows -> barcode vs description,
            // and whether a price is asked for at all.
            updateSwapReasonHint();

            document.getElementById('swapModalOverlay').classList.add('show');
            document.getElementById('swapModal').classList.add('show');

            // Leave the cursor in the barcode box so the scanner can be used straight away -
            // no click needed, which is the point of having one.
            const barcodeBox = document.getElementById('swapBarcodeInput');
            if (barcodeBox && document.getElementById('swapInventoryGroup').style.display !== 'none') {
                barcodeBox.focus();
            }
        }

        // With a frame from stock the confirm button stays locked until a barcode actually
        // resolves, so a typo can't be staged. The customer's own frame has nothing to look
        // up, so it unlocks immediately - and nothing is being sold, so the price field goes
        // away entirely rather than sitting there asking for a number that has no meaning.
        // sp_swap_frame still wants the parameter, so 0 is sent on its behalf.
        function updateSwapSource() {
            const external = document.getElementById('swapSource').value === 'external';

            document.getElementById('swapInventoryGroup').style.display = external ? 'none' : '';
            document.getElementById('swapExternalGroup').style.display = external ? '' : 'none';
            document.getElementById('swapPriceGroup').style.display = external ? 'none' : '';

            const priceInput = document.getElementById('swapPriceInput');
            const confirmBtn = document.getElementById('swapConfirmBtn');

            // required must come off with the field, or the browser blocks submitting a
            // form on a validation error the user cannot even see.
            priceInput.required = !external;

            if (external) {
                document.getElementById('swapNewFrameId').value = '';
                priceInput.value = '0';
                confirmBtn.disabled = false;
            } else {
                priceInput.value = '';
                confirmBtn.disabled = !document.getElementById('swapNewFrameId').value;
            }
        }

        // Spelling out the stock consequence, because "الزبون غيّر رأيه" vs "الإطار تالف"
        // reads like a bookkeeping note but actually decides whether a frame stays sellable.
        //
        // The reason also decides whether asking about the replacement's source makes any
        // sense. A damaged frame is replaced out of stock by definition, so the picker is
        // hidden and forced to stock; only when the old frame is coming back intact can the
        // customer plausibly be supplying the new one themselves.
        function updateSwapReasonHint() {
            const reason = document.getElementById('swapReason');
            const returnsToStock = reason.value === 'true';

            document.getElementById('swapReasonHint').textContent = returnsToStock
                ? 'الإطار القديم يعود للمخزون كقطعة سليمة، والإطار الجديد يُحجز مكانه.'
                : 'الإطار القديم يُشطب ويُسجَّل في سجل التوالف، ولن يعود للمخزون.';

            const sourceGroup = document.getElementById('swapSourceGroup');
            const source = document.getElementById('swapSource');
            const offerSourceChoice = returnsToStock && !source.dataset.compensating;

            sourceGroup.style.display = offerSourceChoice ? '' : 'none';
            if (!offerSourceChoice) source.value = 'stock';

            updateSwapSource();
        }

        function closeSwapModal() {
            document.getElementById('swapModalOverlay').classList.remove('show');
            document.getElementById('swapModal').classList.remove('show');
        }

        // Cancelling one item out of an order. The frame-disposition picker only matters
        // for items that actually have a frame; hiding it otherwise keeps the choice from
        // looking consequential when it isn't (the SP's 'return' default is a no-op then).
        function openCancelItemModal(itemId, itemLabel, itemTotal, isLastActiveItem, hasFrame) {
            document.getElementById('cancelItemLabel').textContent =
                'إلغاء البند: ' + itemLabel + ' — ' + Number(itemTotal).toLocaleString('ar-EG') + ' ج';
            document.getElementById('cancelItemId').value = itemId;
            document.getElementById('cancelItemLastWarning').style.display = isLastActiveItem ? '' : 'none';

            const dispositionGroup = document.getElementById('cancelDispositionGroup');
            dispositionGroup.style.display = hasFrame ? '' : 'none';
            document.getElementById('cancelDisposition').value = 'Return';
            updateCancelDispositionHint();

            document.getElementById('cancelItemForm').querySelector('input[name="notes"]').value = '';
            document.getElementById('cancelItemModalOverlay').classList.add('show');
            document.getElementById('cancelItemModal').classList.add('show');
        }

        // "damage" doesn't just write off the frame - sp_cancel_order_item treats the
        // item's lenses as lost too rather than restocking them. Spelling that out here
        // because it's not something the label itself implies.
        function updateCancelDispositionHint() {
            const value = document.getElementById('cancelDisposition').value;
            document.getElementById('cancelDispositionHint').textContent = value === 'Damage'
                ? 'سيتم شطب الإطار وتسجيله في سجل التوالف، ولن تُرجَع العدسات للمخزون.'
                : 'سيعود الإطار والعدسات إلى المخزون كقطع سليمة.';
        }

        function closeCancelItemModal() {
            document.getElementById('cancelItemModalOverlay').classList.remove('show');
            document.getElementById('cancelItemModal').classList.remove('show');
        }

        function searchSwapFrame() {
            const barcode = document.getElementById('swapBarcodeInput').value.trim();
            const resultBox = document.getElementById('swapFrameResult');
            const errorBox = document.getElementById('swapFrameError');
            resultBox.classList.remove('show');
            errorBox.classList.remove('show');
            document.getElementById('swapConfirmBtn').disabled = true;
            document.getElementById('swapNewFrameId').value = '';

            if (!barcode) return;

            fetch('@Url.Action("LookupFrame")?barcode=' + encodeURIComponent(barcode))
                .then(r => r.json())
                .then(data => {
                    if (data.found) {
                        document.getElementById('swapFrameMeta').innerHTML =
                            '<span><b>' + (data.brand || '') + ' ' + (data.modelName || '') + '</b></span>' +
                            '<span>' + (data.color || '') + ' — ' + (data.size || '') + '</span>' +
                            '<span>السعر: <b>' + Number(data.sellPrice || 0).toLocaleString('ar-EG') + ' ج</b></span>' +
                            '<span>المتاح: <b>' + data.qtyAvailable + '</b></span>';
                        resultBox.classList.add('show');
                        document.getElementById('swapNewFrameId').value = data.frameId;
                        document.getElementById('swapPriceInput').value = data.sellPrice;
                        document.getElementById('swapConfirmBtn').disabled = false;
                    } else {
                        errorBox.textContent = data.message || 'الإطار غير موجود';
                        errorBox.classList.add('show');
                    }
                });
        }

        // Same reason as the wizard's barcode box: the scanner types the code then sends
        // Enter, and Enter in a form means submit. Here that would stage the frame change
        // before a frame had even been looked up.
        (function () {
            const input = document.getElementById('swapBarcodeInput');
            if (!input) return;
            input.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                searchSwapFrame();
            });
        })();

        (function () {
            // Runs on every load, including one arrived at by clicking a status tab: ticks
            // the rows that are still selected from before and rebuilds the toolbar, which
            // is what carries the selection across those navigations.
            syncCheckboxesWithSelection();

            const params = new URLSearchParams(location.search);
            const openId = params.get('openOrder');
            if (openId) openOrderDetail(openId);
        })();
    </script>
}
