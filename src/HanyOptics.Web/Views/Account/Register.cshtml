@model HanyOptics.BusinessLogic.Models.RegisterRequest
@{
    ViewData["Title"] = "إنشاء حساب";
    Layout = "_AuthLayout";
}

<h2 style="font-size:16px;font-weight:700;margin-bottom:16px;text-align:center">إنشاء حساب جديد</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-controller="Account" asp-action="Register" method="post">
    <div class="form-group">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" autocomplete="name" placeholder="الاسم بالكامل" />
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" placeholder="example@hanyoptics.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" placeholder="٦ أحرف على الأقل" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">إنشاء الحساب</button>
</form>

<div class="auth-footer">
    لديك حساب بالفعل؟ <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
</div>
