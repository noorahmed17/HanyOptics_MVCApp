@model HanyOptics.BusinessLogic.Models.DayReport
@using HanyOptics.BusinessLogic.Models
@using HanyOptics.Web.Models
@{
    ViewData["Title"] = "قفلة اليوم";
    var s = Model.Summary;
    string M(decimal v) => ExpenseDisplay.Money(v);
    string N(decimal v) => ExpenseDisplay.Number(v);
    string T(DateTime t) => ExpenseDisplay.Time(t);

    var liveOrders = Model.Orders.Where(o => o.Status != "cancelled").ToList();
    var payNet = Model.Payments.Sum(p => p.SignedAmount);

    (string Css, string Label) EntryType(string t) => t switch
    {
        ExpenseEntryTypes.OwnerDraw => ("mk-owner", "مسحوبات المالك"),
        ExpenseEntryTypes.Income => ("mk-income", "إيراد آخر"),
        _ => ("mk-drawer", "مصروف")
    };
    (string Css, string Label) Source(ExpenseEntry e) =>
        e.IsIncome ? ("mk-income", "أُضيف إلى الدرج")
        : e.FundingSource == FundingSources.Drawer && e.PaymentMethod == PaymentMethods.Cash ? ("mk-drawer", "من الإيرادات")
        : ("mk-outside", "من خارج الإيرادات");
}

<div class="page-header">
    <h2>🌙 قفلة اليوم</h2>
    @if (User.IsInRole(HanyOptics.BusinessLogic.Auth.Roles.Admin))
    {
        <a class="btn btn-outline" asp-controller="Reports" asp-action="Index">→ كل التقارير</a>
    }
</div>

<p class="text-muted mb-3" style="font-size:13px">
    ملخص الإيرادات والمصروفات في يوم العمل، والنقدية المتوقعة في الدرج عند الإغلاق.
</p>

@* The same day picker قفلة اليوم always had: any day can be typed or picked, not only the
   days that already have activity. *@
<form method="get" class="filter-bar">
    <div class="filter-field">
        <label for="date">يوم الشغل</label>
        <input type="date" id="date" name="date" value="@Model.BusinessDate.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary">عرض</button>
    @if (!Model.IsToday)
    {
        <a class="btn btn-outline" asp-action="Index">اليوم الحالي</a>
    }
</form>
<div class="rep-window">
    🕕 يوم العمل من <b>@ExpenseDisplay.DayLabel(Model.BusinessDate)، @T(s.DayStartAt)</b>
    حتى <b>@ExpenseDisplay.DayLabel(Model.BusinessDate.AddDays(1))، @T(s.DayEndAt.AddMinutes(-1))</b>.
    العمليات المسجلة بعد منتصف الليل تُحسب على اليوم نفسه.
</div>

<div class="rep-hero @(s.DrawerCash < 0 ? "neg" : "")">
    <div>
        <div class="lbl">النقدية المتوقعة في الدرج</div>
        <div class="amt">@ExpenseDisplay.Signed(s.DrawerCash)</div>
        <div class="formula">
            <span>إيرادات نقدية <b>@M(s.IncomeCash)</b></span>
            <span>− مصروفات من الإيرادات <b>@M(s.ExpenseFromDrawer)</b></span>
            @if (s.OwnerDrawFromDrawer != 0)
            {
                <span>− مسحوبات المالك <b>@M(s.OwnerDrawFromDrawer)</b></span>
            }
        </div>
    </div>
    <div class="rep-side">
        <div class="row"><span>إجمالي الإيرادات</span><b>@M(s.IncomeTotal)</b></div>
        <div class="row"><span>جميع المصروفات</span><b>@M(s.ExpenseTotal)</b></div>
        <div class="row total"><span>صافي اليوم</span><b>@ExpenseDisplay.Signed(s.Net)</b></div>
    </div>
</div>

<div class="rep-flows">
    <div>
        <div class="rep-flow-title"><span class="in">⬇</span> الإيرادات</div>
        <div class="rep-kpis">
            <div class="stat-card main"><div class="stat-label">إجمالي الإيرادات</div><div class="stat-value">@M(s.IncomeTotal)</div><div class="stat-sub">نقدي وفيزا بعد خصم المرتجعات</div></div>
            <div class="stat-card"><div class="stat-label"><span class="dot" style="background:#057a55"></span>إيرادات نقدية</div><div class="stat-value">@M(s.IncomeCash)</div><div class="stat-sub">@(s.RefundsCash > 0 ? "بعد خصم مرتجعات " + M(s.RefundsCash) : "لا توجد مرتجعات")</div></div>
            <div class="stat-card"><div class="stat-label"><span class="dot" style="background:#1d4ed8"></span>إيرادات الفيزا</div><div class="stat-value">@M(s.IncomeVisa)</div><div class="stat-sub">على ماكينة الدفع، لا تدخل الدرج</div></div>
        </div>
    </div>
    <div>
        <div class="rep-flow-title"><span class="out">⬆</span> المصروفات والمسحوبات</div>
        <div class="rep-kpis">
            <div class="stat-card"><div class="stat-label"><span class="dot" style="background:#057a55"></span>مصروفات من الإيرادات</div><div class="stat-value">@M(s.ExpenseFromDrawer)</div><div class="stat-sub">دُفعت من نقدية الدرج</div></div>
            <div class="stat-card"><div class="stat-label"><span class="dot" style="background:#d97706"></span>مصروفات من خارج الإيرادات</div><div class="stat-value">@M(s.ExpenseFromOutside)</div><div class="stat-sub">مبالغ من خارج الدرج</div></div>
            <div class="stat-card"><div class="stat-label"><span class="dot" style="background:#6d28d9"></span>مسحوبات المالك</div><div class="stat-value">@M(s.OwnerDraw)</div><div class="stat-sub">@(s.OwnerDraw > 0 ? "من الدرج، ولا يُعد مصروفًا" : "لا توجد مسحوبات")</div></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><span class="card-title">مصادر الإيرادات</span><span class="text-muted text-sm">بعد خصم المرتجعات</span></div>
    <div class="card-pad"><partial name="_RevenueSources" model="s" /></div>
</div>

<nav class="rep-jump mt-3" aria-label="جداول اليوم">
    <a href="#t-orders">فواتير اليوم <b>@N(liveOrders.Count)</b></a>
    <a href="#t-del">التسليمات <b>@N(Model.Deliveries.Count)</b></a>
    <a href="#t-pay">المدفوعات <b>@N(Model.Payments.Count)</b></a>
    <a href="#t-exp">المصروفات والحركات الأخرى <b>@N(Model.Entries.Count)</b></a>
</nav>

<div class="card" id="t-orders">
    <div class="card-header">
        <span class="card-title">فواتير اليوم</span>
        <span class="text-muted text-sm"><b>@N(liveOrders.Count)</b> فواتير · القيمة <b>@M(liveOrders.Sum(o => o.TotalAmount))</b></span>
    </div>
    <div class="card-body table-scroll">
        @if (Model.Orders.Count == 0)
        {
            <div class="empty-state">لا توجد فواتير في هذا اليوم.</div>
        }
        else
        {
            <table>
                <thead><tr><th>الوقت</th><th>رقم الفاتورة</th><th>العميل</th><th>النوع</th><th>التسليم</th><th class="num">الإجمالي</th><th class="num">المدفوع</th><th class="num">المتبقي</th><th>الحالة</th></tr></thead>
                <tbody>
                @foreach (var o in Model.Orders)
                {
                    var (stCss, stLabel) = ExpenseDisplay.OrderStatus(o.Status);
                    <tr class="@(o.IsAfterMidnight ? "row-night" : "") @(o.Status == "cancelled" ? "row-cancelled" : "")">
                        <td class="num">@T(o.OrderDate)@if (o.IsAfterMidnight) { <span class="sub">بعد منتصف الليل</span> }</td>
                        <td><bdi>@o.InvoiceNumber</bdi></td>
                        <td><b>@(o.CustomerName ?? "—")</b></td>
                        <td>@ExpenseDisplay.ItemTypes(o.ItemTypes)</td>
                        <td>@if (o.DeliveryType == "immediate") { <span class="mk mk-info">فوري</span> } else { <span class="mk mk-muted">عادي</span> }</td>
                        <td class="num amount">@N(o.TotalAmount)</td>
                        <td class="num c-green">@N(o.PaidAmount)</td>
                        <td class="num @(o.RemainingAmount > 0 ? "" : "text-muted")">@(o.RemainingAmount > 0 ? N(o.RemainingAmount) : "—")</td>
                        <td><span class="badge @stCss">@stLabel</span></td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><td colspan="5">الإجمالي (بدون الملغي)</td><td class="num">@N(liveOrders.Sum(o => o.TotalAmount))</td><td class="num">@N(liveOrders.Sum(o => o.PaidAmount))</td><td class="num">@N(liveOrders.Sum(o => o.RemainingAmount))</td><td></td></tr>
                </tfoot>
            </table>
        }
    </div>
</div>

<div class="card" id="t-del">
    <div class="card-header">
        <span class="card-title">التسليمات</span>
        <span class="text-muted text-sm"><b>@N(Model.Deliveries.Count)</b> تسليمات · القيمة <b>@M(Model.Deliveries.Sum(d => d.TotalAmount))</b></span>
    </div>
    <div class="card-body table-scroll">
        @if (Model.Deliveries.Count == 0)
        {
            <div class="empty-state">لا توجد تسليمات في هذا اليوم.</div>
        }
        else
        {
            <table>
                <thead><tr><th>وقت التسليم</th><th>رقم الفاتورة</th><th>العميل</th><th>تاريخ الفاتورة</th><th class="num">قيمة الفاتورة</th><th class="num">المحصَّل عند التسليم</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Deliveries)
                {
                    <tr>
                        <td class="num">@T(d.DeliveredAt)</td>
                        <td><bdi>@d.InvoiceNumber</bdi></td>
                        <td><b>@(d.CustomerName ?? "—")</b></td>
                        <td>@ExpenseDisplay.DayLabel(DateOnly.FromDateTime(d.OrderDate))</td>
                        <td class="num">@N(d.TotalAmount)</td>
                        <td class="num @(d.CollectedToday != 0 ? "c-green" : "text-muted")">@(d.CollectedToday != 0 ? N(d.CollectedToday) : "مسددة مسبقًا")</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><td colspan="4">الإجمالي</td><td class="num">@N(Model.Deliveries.Sum(d => d.TotalAmount))</td><td class="num">@N(Model.Deliveries.Sum(d => d.CollectedToday))</td></tr></tfoot>
            </table>
        }
    </div>
    <div class="card-pad" style="padding-top:0">
        <div class="alert alert-info mt-3" style="margin-bottom:0;font-size:12px">
            ℹ️ الطلبات الفورية المسددة بالكامل لا تظهر هنا لأنها محسوبة في فواتير اليوم. أما الطلب الفوري الذي عليه مبلغ متبقٍ فيظهر في التسليمات.
        </div>
    </div>
</div>

<div class="card" id="t-pay">
    <div class="card-header">
        <span class="card-title">المدفوعات</span>
        <span class="text-muted text-sm"><b>@N(Model.Payments.Count)</b> عمليات · الصافي <b>@ExpenseDisplay.Signed(payNet)</b></span>
    </div>
    <div class="card-body table-scroll">
        @if (Model.Payments.Count == 0)
        {
            <div class="empty-state">لا توجد مدفوعات في هذا اليوم.</div>
        }
        else
        {
            <table>
                <thead><tr><th>الوقت</th><th>رقم الفاتورة</th><th>العميل</th><th>نوع الدفعة</th><th>الفاتورة</th><th>الطريقة</th><th class="num">المبلغ</th><th>المستلم</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    var refund = p.PaymentType == "refund";
                    <tr class="@(p.IsAfterMidnight ? "row-night" : "")">
                        <td class="num">@T(p.PaidAt)</td>
                        <td><bdi>@p.InvoiceNumber</bdi></td>
                        <td><b>@(p.CustomerName ?? "—")</b></td>
                        <td>@if (refund) { <span class="mk mk-bad">مرتجع</span> } else { @ExpenseDisplay.PaymentType(p.PaymentType) }</td>
                        <td>@if (p.OrderEvent == "exchange_frame") { <span class="mk mk-info">استبدال</span> } else if (p.OrderEvent == "return_item") { <span class="mk mk-bad">مرتجع بعد التسليم</span> } else if (refund) { <span class="text-muted">—</span> } else if (p.IsOldInvoice) { <span class="mk mk-info">فاتورة سابقة</span> } else { <text>فاتورة اليوم</text> }</td>
                        <td><span class="badge @(p.PaymentMethod == PaymentMethods.Visa ? "badge-visa" : "badge-cash")">@(p.PaymentMethod == PaymentMethods.Visa ? "فيزا" : "نقدي")</span></td>
                        <td class="num fw-bold @(refund ? "c-red" : "")">@(refund ? "− " : "")@N(p.Amount)</td>
                        <td>@(p.ReceivedBy ?? "—")</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><td colspan="6">الصافي — نقدي @N(s.SalesCash - s.RefundsCash) · فيزا @N(s.SalesVisa - s.RefundsVisa)</td><td class="num">@ExpenseDisplay.Signed(payNet)</td><td></td></tr></tfoot>
            </table>
        }
    </div>
</div>

<div class="card" id="t-exp">
    <div class="card-pad">
        <div class="rep-grid2">
            <div>
                <div class="flex justify-between items-center mb-3">
                    <span class="card-title">المصروفات حسب النوع</span>
                    <div class="rep-legend"><span><i class="seg-d"></i>من الإيرادات</span><span><i class="seg-o"></i>من خارج الإيرادات</span></div>
                </div>
                <partial name="_CategoryBars" model="Model.Categories" />
            </div>
            <div>
                <div class="card-title mb-3">ملخص الحركات</div>
                <table class="ledger">
                    <tr><td class="op"></td><td>مصروفات من الإيرادات</td><td>@M(s.ExpenseFromDrawer)</td></tr>
                    <tr><td class="op"></td><td>مصروفات من خارج الإيرادات</td><td>@M(s.ExpenseFromOutside)</td></tr>
                    <tr class="owner"><td class="op"></td><td>مسحوبات المالك</td><td>@M(s.OwnerDraw)</td></tr>
                    <tr><td class="op"></td><td>إيرادات أخرى (أُضيفت)</td><td class="c-green">@M(s.OtherIncomeTotal)</td></tr>
                </table>
            </div>
        </div>
    </div>
    <div class="card-header" style="border-top:1px solid #f1f5f9">
        <span class="card-title">المصروفات والحركات الأخرى</span>
        <span class="text-muted text-sm"><b>@N(Model.Entries.Count)</b> حركات</span>
    </div>
    <div class="card-body table-scroll">
        @if (Model.Entries.Count == 0)
        {
            <div class="empty-state">لا توجد حركات.</div>
        }
        else
        {
            <table>
                <thead><tr><th>الوقت</th><th>النوع</th><th>التفاصيل</th><th>المصدر</th><th>الطريقة</th><th class="num">المبلغ</th><th>سجّلها</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Entries)
                {
                    var (tCss, tLabel) = EntryType(e.EntryType);
                    var (sCss, sLabel) = Source(e);
                    <tr>
                        <td class="num">@T(e.PaidAt)</td>
                        <td><span class="mk @tCss">@tLabel</span></td>
                        <td>
                            @if (e.EntryType == ExpenseEntryTypes.OwnerDraw) { <b class="c-purple">مسحوبات المالك</b> } else { <b>@(e.Category ?? "—")</b> }
                            @if (e.SupplierName is not null) { <text> · @e.SupplierName</text> }
                            @if (!string.IsNullOrWhiteSpace(e.Description) && e.Description != e.Category) { <span class="sub">@e.Description</span> }
                        </td>
                        <td><span class="mk @sCss">@sLabel</span></td>
                        <td><span class="badge @(e.PaymentMethod == PaymentMethods.Visa ? "badge-visa" : "badge-cash")">@(e.PaymentMethod == PaymentMethods.Visa ? "فيزا" : "نقدي")</span></td>
                        <td class="num fw-bold @(e.IsIncome ? "c-green" : "")">@(e.IsIncome ? "+ " : "− ")@N(e.Amount)</td>
                        <td>@(e.CreatedBy ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/daily-close.js" asp-append-version="true"></script>
}
