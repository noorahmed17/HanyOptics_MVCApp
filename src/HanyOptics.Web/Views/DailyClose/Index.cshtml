@model HanyOptics.BusinessLogic.Models.DailyCloseReport
@using System.Globalization
@{
    ViewData["Title"] = "قفلة اليوم";

    var arEg = CultureInfo.GetCultureInfo("ar-EG");
    var s = Model.Summary;

    string Money(decimal v) => v.ToString("N0", arEg) + " ج";
    string Num(decimal v) => v.ToString("N0", arEg);
    string Time(DateTime t) => t.ToString("h:mm tt", arEg);
    string Day(DateTime t) => t.ToString("dddd d MMMM", arEg);

    // The item-type badges, coloured the way the rest of the app colours a kind of thing.
    (string Css, string Label) ItemBadge(string type) => type switch
    {
        "frame_lenses" => ("badge-fl", "إطار + عدسات"),
        "frame_only" => ("badge-fo", "إطار فقط"),
        "lenses_replace" => ("badge-lr", "عدسات على إطار الزبون"),
        _ => ("badge-user", type)
    };

    (string Css, string Label) StatusBadge(string status) => status switch
    {
        "sold" => ("badge-sold", "مباع"),
        "ready" => ("badge-ready", "جاهز"),
        "delivered" => ("badge-delivered", "تم التسليم"),
        "cancelled" => ("badge-cancelled", "ملغي"),
        _ => ("badge-user", status)
    };

    // The totals row sums only the live orders, because vw_daily_close's orders_total does
    // the same - a cancelled invoice still shows in the list so you can see it was voided,
    // but counting its money would make the footer disagree with the card above it.
    var liveOrders = Model.Orders.Where(o => o.Status != "cancelled").ToList();
    var cancelledCount = Model.Orders.Count - liveOrders.Count;

    string PaymentTypeLabel(string t) => t switch
    {
        "deposit" => "عربون",
        "final" => "باقي",
        "full" => "كامل",
        "refund" => "مردود",
        _ => t
    };
}

<div class="page-header">
    <h2>🌙 قفلة اليوم</h2>
    <a class="btn btn-outline" asp-controller="Reports" asp-action="Index">→ كل التقارير</a>
</div>

<p class="text-muted mb-3" style="font-size:13px">
    كل اللي حصل في يوم شغل واحد: بعت كام، سلّمت كام، ودخل الدرج كام كاش وكام فيزا.
</p>

<form method="get" class="filter-bar">
    <div class="filter-field">
        <label>يوم الشغل</label>
        <input type="date" name="date" value="@Model.BusinessDate.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary">عرض</button>
    @if (!Model.IsCurrentDay)
    {
        <a class="btn btn-outline" asp-action="Index">اليوم الحالي</a>
    }

    @* Spelling out the window matters here: someone looking at 1am needs to know the sale
       they just rang up lands on tonight's sheet, not tomorrow's. *@
    @if (s is not null)
    {
        <div class="daywindow">
            🕕 اليوم المحاسبي: من <b>@Day(s.DayStartAt) @Time(s.DayStartAt)</b>
            لحد <b>@Day(s.DayEndAt) @Time(s.DayEndAt.AddMinutes(-1))</b>
            <br><span class="text-muted">أي بيعة أو دفعة بعد نص الليل بتفضل محسوبة على نفس يوم الشغل.</span>
        </div>
    }
</form>

@if (s is null)
{
    <div class="card">
        <div class="empty-state">
            مفيش أي حركة في اليوم ده — لا أوردرات ولا دفعات ولا تسليمات.
        </div>
    </div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card hero">
            <div class="stat-icon">💰</div>
            <div class="stat-label">اللي دخل الدرج (صافي)</div>
            <div class="stat-value num">@Money(s.NetTotal)</div>
            <div class="stat-sub">كاش + فيزا، ناقص المردودات</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💵</div>
            <div class="stat-label">كاش في الدرج</div>
            <div class="stat-value num c-green">@Money(s.CashNet)</div>
            <div class="stat-sub">
                @if (s.RefundsTotal > 0) { <text>بعد خصم @Money(s.RefundsTotal) مردودات</text> }
                else { <text>مفيش مردودات</text> }
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💳</div>
            <div class="stat-label">فيزا (على الماكينة)</div>
            <div class="stat-value num c-blue">@Money(s.VisaNet)</div>
            <div class="stat-sub">@Num(s.PaymentsCount) حركة في اليوم</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🧾</div>
            <div class="stat-label">مبيعات اليوم</div>
            <div class="stat-value num c-purple">@Money(s.OrdersTotal)</div>
            <div class="stat-sub">@Num(s.OrdersCount) أوردر اتفتح</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-label">تسليمات اليوم</div>
            <div class="stat-value num c-amber">@Num(s.DeliveriesCount)</div>
            <div class="stat-sub">بقيمة @Money(s.DeliveriesTotal)</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title">💰 الفلوس دخلت منين؟</div>
            @if (s.LastActivityAt is not null)
            {
                <div class="card-note">آخر حركة: @Time(s.LastActivityAt.Value)</div>
            }
        </div>
        <div class="card-pad">
            @if (s.NetTotal > 0)
            {
                <div class="splitbar">
                    <div style="width:@(s.CashShare.ToString(CultureInfo.InvariantCulture))%;background:#057a55"></div>
                    <div style="width:@(s.VisaShare.ToString(CultureInfo.InvariantCulture))%;background:#1a56db"></div>
                </div>
                <div class="legend mb-3">
                    <span><i style="background:#057a55"></i>كاش @Money(s.CashNet) (@s.CashShare.ToString("0.#", arEg)%)</span>
                    <span><i style="background:#1a56db"></i>فيزا @Money(s.VisaNet) (@s.VisaShare.ToString("0.#", arEg)%)</span>
                </div>
            }

            <table class="breakdown">
                <tr>
                    <td>دفعات على فواتير اتفتحت اليوم</td>
                    <td class="num" style="text-align:left">@Money(s.FromTodayInvoices)</td>
                </tr>
                <tr>
                    <td>باقي فواتير قديمة اتحصّل اليوم <span class="badge badge-old">عميل جه استلم</span></td>
                    <td class="num" style="text-align:left">@Money(s.FromOldInvoices)</td>
                </tr>
                <tr>
                    <td>مردودات طلعت من الدرج</td>
                    <td class="num c-red" style="text-align:left">@(s.RefundsTotal > 0 ? "− " + Money(s.RefundsTotal) : Money(0))</td>
                </tr>
                <tr>
                    <td>صافي اللي في الدرج آخر اليوم</td>
                    <td class="num" style="text-align:left">@Money(s.NetTotal)</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="section-divider"><span>🧾 أوردرات اتعملت في اليوم</span></div>
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                @Num(liveOrders.Count) أوردر · إجمالي @Money(s.OrdersTotal)
                @if (cancelledCount > 0)
                {
                    <span class="badge badge-cancelled">+@Num(cancelledCount) ملغي</span>
                }
            </div>
            <div class="card-note">🌙 = اتعمل بعد نص الليل، ومحسوب على نفس يوم الشغل</div>
        </div>
        @if (Model.Orders.Count == 0)
        {
            <div class="empty-state">مفيش أوردرات اتفتحت في اليوم ده.</div>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                    <tr>
                        <th>الوقت</th><th>الفاتورة</th><th>العميل</th><th>النوع</th>
                        <th class="num">الإجمالي</th><th class="num">مدفوع</th><th class="num">باقي</th><th>الحالة</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        var st = StatusBadge(o.Status);
                        <tr class="@(o.IsAfterMidnight ? "row-night" : "")">
                            <td class="num">
                                @Time(o.OrderDate)
                                @if (o.IsAfterMidnight) { <span class="badge badge-night">🌙</span> }
                            </td>
                            <td>@o.InvoiceNumber</td>
                            <td>@o.CustomerName</td>
                            <td>
                                @foreach (var t in (o.ItemTypes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var b = ItemBadge(t.Trim());
                                    <span class="badge @b.Css">@b.Label</span>
                                }
                            </td>
                            <td class="num">@Num(o.TotalAmount)</td>
                            <td class="num c-green">@Num(o.PaidAmount)</td>
                            @* A negative balance means the customer paid more than the order
                               came to. Showing it as "—" would read as settled and hide money
                               that is owed back, so it is called out as a credit instead. *@
                            <td class="num @(o.RemainingAmount > 0 ? "c-amber" : o.RemainingAmount < 0 ? "c-red" : "")">
                                @if (o.RemainingAmount > 0)
                                {
                                    @Num(o.RemainingAmount)
                                }
                                else if (o.RemainingAmount < 0)
                                {
                                    <text>@Num(Math.Abs(o.RemainingAmount)) <span class="badge badge-cancelled">زيادة</span></text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td><span class="badge @st.Css">@st.Label</span></td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="4">الإجمالي @(cancelledCount > 0 ? "(من غير الملغي)" : "")</td>
                        <td class="num">@Num(liveOrders.Sum(o => o.TotalAmount))</td>
                        <td class="num">@Num(liveOrders.Sum(o => o.PaidAmount))</td>
                        <td class="num c-amber">@Num(liveOrders.Sum(o => o.RemainingAmount))</td>
                        <td></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <div class="section-divider"><span>📦 اللي اتسلّم في اليوم</span></div>
    <div class="card">
        <div class="card-header">
            <div class="card-title">@Num(Model.Deliveries.Count) تسليم · قيمتها @Money(s.DeliveriesTotal)</div>
            <div class="card-note">فيهم فواتير قديمة العميل جه استلمها اليوم</div>
        </div>
        @if (Model.Deliveries.Count == 0)
        {
            <div class="empty-state">مفيش تسليمات في اليوم ده.</div>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                    <tr>
                        <th>وقت التسليم</th><th>الفاتورة</th><th>العميل</th>
                        <th class="num">قيمة الطلب</th><th class="num">اتحصّل عند الاستلام</th><th>الفاتورة من</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.Deliveries)
                    {
                        <tr class="@(d.IsAfterMidnight ? "row-night" : "")">
                            <td class="num">
                                @Time(d.DeliveredAt)
                                @if (d.IsAfterMidnight) { <span class="badge badge-night">🌙</span> }
                            </td>
                            <td>@d.InvoiceNumber</td>
                            <td>@d.CustomerName</td>
                            <td class="num">@Num(d.TotalAmount)</td>
                            <td class="num @(d.CollectedToday > 0 ? "c-green" : "")">
                                @(d.CollectedToday > 0 ? Num(d.CollectedToday) : "—")
                            </td>
                            <td>
                                @if (d.IsSameDay)
                                {
                                    <span class="badge badge-sold">نفس اليوم</span>
                                }
                                else
                                {
                                    <span class="badge badge-old">@d.OrderDate.ToString("d MMMM", arEg)</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="3">الإجمالي</td>
                        <td class="num">@Num(Model.Deliveries.Sum(d => d.TotalAmount))</td>
                        <td class="num">@Num(Model.Deliveries.Sum(d => d.CollectedToday))</td>
                        <td></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <div class="section-divider"><span>💵 كل حركة فلوس في اليوم</span></div>
    <div class="card">
        <div class="card-header">
            <div class="card-title">@Num(Model.Payments.Count) حركة · صافي @Money(s.NetTotal)</div>
            <div class="card-note">المردود بينزل بالسالب من الدرج</div>
        </div>
        @if (Model.Payments.Count == 0)
        {
            <div class="empty-state">مفيش حركة فلوس في اليوم ده.</div>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                    <tr>
                        <th>الوقت</th><th>الفاتورة</th><th>العميل</th>
                        <th>نوع الدفعة</th><th>الطريقة</th><th class="num">المبلغ</th><th>استلمها</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        var refund = p.PaymentType == "refund";
                        <tr class="@(refund ? "row-refund" : p.IsAfterMidnight ? "row-night" : "")">
                            <td class="num">
                                @Time(p.PaidAt)
                                @if (p.IsAfterMidnight) { <span class="badge badge-night">🌙</span> }
                            </td>
                            <td>@p.InvoiceNumber</td>
                            <td>@p.CustomerName</td>
                            <td>
                                @if (refund)
                                {
                                    <span class="badge badge-cancelled">مردود</span>
                                }
                                else
                                {
                                    @PaymentTypeLabel(p.PaymentType)
                                    @if (p.IsOldInvoice) { <span class="badge badge-old">فاتورة قديمة</span> }
                                }
                            </td>
                            <td>
                                <span class="badge @(p.PaymentMethod == "visa" ? "badge-visa" : "badge-cash")">
                                    @(p.PaymentMethod == "visa" ? "فيزا" : "كاش")
                                </span>
                            </td>
                            <td class="num @(refund ? "c-red" : "c-green")">
                                @(refund ? "− " + Num(p.Amount) : Num(p.Amount))
                            </td>
                            <td>@p.ReceivedBy</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="5">صافي الدرج (كاش @Num(s.CashNet) + فيزا @Num(s.VisaNet))</td>
                        <td class="num">@Num(Model.Payments.Sum(p => p.SignedAmount))</td>
                        <td></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    @* Only worth a section when there is actually something to act on. *@
    @if (s.OrdersRemaining > 0 || s.RefundsCount > 0 || Model.Orders.Any(o => o.Status == "ready"))
    {
        <div class="section-divider"><span>⚠️ محتاج انتباهك</span></div>
        <div class="alerts">
            @if (s.OrdersRemaining > 0)
            {
                var owing = Model.Orders.Where(o => o.RemainingAmount > 0).ToList();
                <div class="alert-box warn">
                    <div class="alert-title">⏳ أوردرات اليوم لسه عليها باقي</div>
                    <div class="alert-value num c-amber">@Money(s.OrdersRemaining)</div>
                    <div class="alert-desc">
                        @Num(owing.Count) أوردر: @string.Join(" · ", owing.Select(o => o.InvoiceNumber))
                    </div>
                </div>
            }

            @if (s.RefundsCount > 0)
            {
                var refunds = Model.Payments.Where(p => p.PaymentType == "refund").ToList();
                <div class="alert-box">
                    <div class="alert-title">↩️ مردودات اليوم</div>
                    <div class="alert-value num c-red">@Money(s.RefundsTotal)</div>
                    <div class="alert-desc">
                        @Num(s.RefundsCount) حركة — @string.Join(" · ", refunds.Select(p => p.InvoiceNumber))
                    </div>
                </div>
            }

            @{ var ready = Model.Orders.Where(o => o.Status == "ready").ToList(); }
            @if (ready.Count > 0)
            {
                <div class="alert-box info">
                    <div class="alert-title">✅ جاهز ومستني الاستلام</div>
                    <div class="alert-value num">@Num(ready.Count)</div>
                    <div class="alert-desc">
                        @string.Join(" · ", ready.Select(o => o.InvoiceNumber + " — " + o.CustomerName))
                    </div>
                </div>
            }
        </div>
    }
}

<p class="text-muted mt-3" style="font-size:12px">
    كل الأرقام بتتقرا من الداتا مباشرة — الصفحة دي بتعرض بس، مش بتكتب أو بتعدّل أي حاجة.
</p>
