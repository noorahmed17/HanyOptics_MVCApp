@model HanyOptics.BusinessLogic.Models.AddFrameRequest
@{
    ViewData["Title"] = "إضافة إطار";
    var addedName = TempData["FrameAddedName"] as string;
    var addedBarcode = TempData["FrameAddedBarcode"] as string;
}

<div class="page-header">
    <h2>➕ إضافة إطار للمخزون</h2>
    <a class="btn btn-outline" asp-action="Index">→ رجوع للمخزون</a>
</div>

@* The generated barcode is the whole output of saving - it is what goes into BarTender to
   print the label - so it gets its own panel rather than a line in a toast that disappears. *@
@if (!string.IsNullOrEmpty(addedBarcode))
{
    <div class="barcode-result">
        <div class="barcode-result-head">✅ تم إضافة @addedName للمخزون</div>
        <div class="barcode-result-label">الباركود المتولّد — اطبعه على الإطار</div>
        <div class="barcode-result-code" id="generatedBarcode">@addedBarcode</div>
        <button type="button" class="btn btn-outline btn-sm" onclick="copyBarcode()">📋 نسخ الباركود</button>
        <span class="barcode-copied" id="barcodeCopied">اتنسخ ✔️</span>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="AddFrame" method="post" id="addFrameForm">
    <div class="wizard-content">
        <div class="form-row">
            <div class="form-group">
                <label>الماركة *</label>
                <input asp-for="Brand" id="frameBrandInput" placeholder="مثال: Ray-Ban" autocomplete="off" />
                <span asp-validation-for="Brand" class="field-error"></span>
            </div>
            <div class="form-group">
                <label>الموديل</label>
                <input asp-for="ModelName" placeholder="مثال: RB5154" autocomplete="off" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>اللون</label>
                <input asp-for="Color" placeholder="مثال: أسود" autocomplete="off" />
            </div>
            <div class="form-group">
                <label>المقاس</label>
                <input asp-for="Size" placeholder="مثال: 54" autocomplete="off" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>النوع</label>
                <select asp-for="Category">
                    <option value="Optical">👓 طبي</option>
                    <option value="Sun">☀️ شمس</option>
                </select>
            </div>
            <div class="form-group">
                <label>طريقة التتبع</label>
                <select asp-for="TrackingType" id="frameTrackingInput" onchange="updateTrackingMode()">
                    <option value="Individual">🏷️ قطعة واحدة</option>
                    <option value="Bulk">📦 بالكمية</option>
                </select>
            </div>
        </div>

        <div class="section-divider"><span>💰 الأسعار</span></div>

        <div class="form-row">
            <div class="form-group">
                <label>تكلفة الشراء (ج)</label>
                <input type="number" asp-for="CostPrice" min="0" step="0.01" />
                <span asp-validation-for="CostPrice" class="field-error"></span>
            </div>
            <div class="form-group">
                <label>سعر البيع (ج) *</label>
                <input type="number" asp-for="SellPrice" id="frameSellInput" min="0" step="0.01" />
                <span asp-validation-for="SellPrice" class="field-error"></span>
                @* Not a nicety: the price is encoded inside the barcode, so getting it wrong
                   here means reprinting the label, not just editing a field. *@
                <div class="form-hint">الباركود بيتولّد من السعر ده — تأكد منه قبل الحفظ.</div>
            </div>
        </div>

        @* Only meaningful for a bulk line - an individual frame is one piece, and the
           service forces the quantity to 1 regardless of what is posted. *@
        <div class="form-group" id="frameQtyGroup" style="display:none">
            <label>الكمية المستلمة *</label>
            <input type="number" asp-for="Quantity" id="frameQtyInput" min="1" step="1" />
            <span asp-validation-for="Quantity" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>ملاحظات (اختياري)</label>
            <input asp-for="Notes" placeholder="مثال: دفعة المورد رقم 12" autocomplete="off" />
        </div>

        <div class="wizard-footer">
            <a class="btn btn-outline" asp-action="Index">إلغاء</a>
            <button type="submit" class="btn btn-primary btn-lg">✔️ إدخال وتوليد الباركود</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        // An individual frame is a single piece; only a bulk line has a quantity to receive.
        function updateTrackingMode() {
            var bulk = document.getElementById('frameTrackingInput').value === 'Bulk';
            var qtyGroup = document.getElementById('frameQtyGroup');
            var qtyInput = document.getElementById('frameQtyInput');

            qtyGroup.style.display = bulk ? '' : 'none';
            qtyInput.disabled = !bulk;
            if (!bulk) { qtyInput.value = 1; }
        }

        function copyBarcode() {
            var code = document.getElementById('generatedBarcode').textContent.trim();
            var done = document.getElementById('barcodeCopied');

            // Retyping a code into BarTender is exactly how a label ends up on the wrong
            // frame, so make copying it the easy path.
            navigator.clipboard.writeText(code).then(function () {
                done.classList.add('show');
                setTimeout(function () { done.classList.remove('show'); }, 1800);
            });
        }

        updateTrackingMode();
        document.getElementById('frameBrandInput').focus();
    </script>
}
