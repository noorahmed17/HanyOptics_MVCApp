@{
    var action = (string?)ViewContext.RouteData.Values["action"] ?? "";
    string Tab(string a) => string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "tab active" : "tab";
}
<div class="page-header">
    <h2>📊 التقارير</h2>
</div>
<div class="tabs">
    <a class="@Tab("Day")" asp-action="Day">🌙 إغلاق اليومية</a>
    <a class="@Tab("Month")" asp-action="Month">📅 التقرير الشهري</a>
    <a class="@Tab("Expenses")" asp-action="Expenses">🧾 مصروفات الشهر</a>
</div>
