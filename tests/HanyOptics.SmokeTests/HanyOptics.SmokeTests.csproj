<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>HanyOptics.SmokeTests</AssemblyName>
    <RootNamespace>HanyOptics.SmokeTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HanyOptics.Web\HanyOptics.Web.csproj" />
  </ItemGroup>

  <!--
    WebApplicationFactory finds a content root by walking up to the solution file and then
    looking for <solution>/<assembly name>. This project's web app lives under src/, so that
    guess lands in the wrong place and the Razor views cannot be found.

    The path is built here rather than written into a source file so it resolves on whatever
    machine does the build - a literal D:\... in the code would only ever work on one laptop.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryContentRootAttribute">
      <_Parameter1>HanyOptics.Web</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\HanyOptics.Web'))</_Parameter2>
      <_Parameter3>appsettings.json</_Parameter3>
      <_Parameter4>1</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
